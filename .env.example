# ------------------------------------------------------------------
# SaaS Imob — Environment Configuration (Phase 1)
# Copy to `.env`, `.env.local`, and `.env.production` as appropriate.
# NEVER commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (docker-compose exposes :5432)
DATABASE_URL=postgresql://saas:saas_password@localhost:5432/saas_imob?schema=public

# Redis connection string used by the app cache, queue producers and BullMQ workers
REDIS_URL=redis://localhost:6379

# Secret used to sign session JWTs (HS256).
# Generate with: openssl rand -hex 32   (must be >= 32 chars)
JWT_SECRET=change-me-to-a-64-character-random-hex-secret-0000

# Session JWT lifetime. Accepts a plain number (seconds) or a unit suffix:
# 300, "5m", "8h", "7d"
JWT_EXPIRES_IN=8h

# HttpOnly cookie name that carries the session JWT
SESSION_COOKIE=saas_session

# Root domain of the application, used for subdomain-based tenant resolution.
# In local development against the compose stack use: app.saas.local (=> *.saas.local via /etc/hosts or nip.io).
# Leave empty when developing on localhost — tenant resolution then falls back to
# the X-Tenant-Slug header / tenant query parameter.
APP_DOMAIN=saas.local

# Public base URL of the application
APP_URL=http://localhost:3000

# Password used by the seeded demo users (both default & platform admin)
SEED_ADMIN_PASSWORD=ChangeMe-123!

# ------------------------------------------------------------------
# Object storage (Phase 2 media pipeline) — S3-compatible
# Leave empty to use the in-process LOCAL fallback (dev/tests only).
# Configure for AWS S3, Cloudflare R2, DigitalOcean Spaces or MinIO.
# ------------------------------------------------------------------
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # empty = AWS default
# S3_REGION=auto
# S3_BUCKET=saas-imob-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional public CDN base used to render objects (no presign needed)
# S3_PUBLIC_BASE_URL=https://media.example.com

# ------------------------------------------------------------------
# Phase 5 — Billing (payment gateway webhooks + dunning engine)
# ------------------------------------------------------------------
# Webhook signing secrets. When empty, signature verification is skipped
# (development only) — always set these in any real environment.
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_live_...
# ASAAS_WEBHOOK_SECRET=...
# ASAAS_API_KEY=...
# ASAAS_API_URL=https://sandbox.asaas.com
# CUSTOM_WEBHOOK_SECRET=change-me-to-a-shared-webhook-secret

# Dunning engine tuning
# BILLING_GRACE_DAYS=5
# BILLING_PRE_DUE_NOTIFY_DAYS=3
# Master switch for automatic suspension when the grace period expires.
# BILLING_AUTOSUSPEND_ENABLED=true

# ------------------------------------------------------------------
# Phase 6 — Transactional e-mail (Resend / SendGrid / SES / console)
# ------------------------------------------------------------------
# Active transport: "console" (logs, dev/test) | "resend" | "sendgrid" | "ses"
EMAIL_PROVIDER=console
# Resend (re_...) or SendGrid (SG.) API key. Empty is fine for console.
# EMAIL_API_KEY=
EMAIL_FROM=naoresponda@imob.example.com
EMAIL_FROM_NAME="imobFlow"
# AWS SES credentials (only used when EMAIL_PROVIDER=ses).
# SES_REGION=us-east-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# Password-reset token lifetime (seconds, min 60, max 86400).
RESET_TOKEN_TTL_SECONDS=900

# ------------------------------------------------------------------
# Phase 6 — Security hardening
# ------------------------------------------------------------------
# Rate limiting (per IP). Values are max requests inside the window.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH=10            # login / forgot / reset
# RATE_LIMIT_PUBLIC_LEADS=30    # public lead intake (portal surges)
# Comma-separated origins allowed to call /api/public/* cross-origin.
# CORS_ORIGINS=https://imob.example.com,https://parceiro.example.com